<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Klaviyo adds a second, ungated loader on the checkout page. The consent-gated loader in
             services/klaviyo.phtml covers the checkout as well. -->
        <referenceBlock name="klaviyo_reclaim.checkout.initialize" remove="true"/>
    </body>
</page>
