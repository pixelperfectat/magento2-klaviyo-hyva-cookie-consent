<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Klaviyo's own loader blocks are removed by Observer\RemoveUngatedKlaviyoLoaders while the
             cookie consent module is on; services/klaviyo.phtml loads Klaviyo after consent instead. -->

        <!-- Defines window.klaviyoConsentGranted() before any Klaviyo template runs. -->
        <referenceContainer name="head.additional">
            <block name="klaviyo.hyva.cookie.consent.check"
                   template="PixelPerfect_KlaviyoHyvaCookieConsent::consent-check.phtml"
                   ifconfig="web/hyva_cookie_consent/general/enabled">
                <arguments>
                    <argument name="consent_gate" xsi:type="object">
                        PixelPerfect\KlaviyoHyvaCookieConsent\Model\ConsentGate
                    </argument>
                </arguments>
            </block>
        </referenceContainer>

        <referenceContainer name="before.body.end">
            <block name="hyva.cookie.consent.service.klaviyo"
                   template="PixelPerfect_KlaviyoHyvaCookieConsent::services/klaviyo.phtml"
                   ifconfig="hyva_cookie_consent/services/klaviyo/enabled"
                   after="hyva.cookie.consent.service.matomo">
                <arguments>
                    <argument name="view_model" xsi:type="object">
                        Pixelperfect\HyvaCookieConsent\ViewModel\CookieConsent
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
