<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use PixelPerfect\KlaviyoHyvaCookieConsent\ViewModel\KlaviyoConfig;
use Pixelperfect\HyvaCookieConsent\ViewModel\CookieConsent;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */

$consentViewModel = $block->getData('view_model');
if (!$consentViewModel instanceof CookieConsent) {
    $consentViewModel = $viewModels->require(CookieConsent::class);
}

$service = $consentViewModel->getServicePool()->getService('klaviyo');
if (!$service || !$service->isEnabled()) {
    return;
}

/** @var KlaviyoConfig $klaviyoConfig */
$klaviyoConfig = $viewModels->require(KlaviyoConfig::class);

if (!$klaviyoConfig->isEnabled()) {
    return;
}

$klaviyoSrc = $klaviyoConfig->getCdnUrl();
if ($klaviyoSrc === null) {
    return;
}

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
$category = $service->getCategory();
?>

<!-- Override default consent check to use cookie consent groups -->
<script>
    window.klaviyoConsentGranted = function() {
        return window.cookie_consent_groups && window.cookie_consent_groups.marketing || false;
    };
</script>
<?php $hyvaCsp->registerInlineScript() ?>

<!-- Klaviyo CDN — gated until marketing consent -->
<template data-consent-category="<?= $escaper->escapeHtmlAttr($category) ?>">
    <script async src="<?= $escaper->escapeUrl($klaviyoSrc) ?>"></script>
</template>
